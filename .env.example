# Copy to .env for local use. Never commit real secrets.
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000
# Defaults to ./data. Production must point inside a durable disk.
# STUDYFORGE_DATA_DIR=/var/data/studyforge
# Defaults to DATA_DIR/models. Download once with setup_model.py.
# EMBEDDING_CACHE_DIR=/opt/studyforge-models
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Required in production: stable Fernet key; generate with README command.
# ENCRYPTION_KEY=
# Recommended for a personal public deployment.
# REGISTRATION_INVITE_CODE=
# Public frontend configuration only. Same-origin deployment is supported.
VITE_API_BASE_URL=/api
# Enter provider keys in Settings. Never use a VITE_ variable for a secret.
